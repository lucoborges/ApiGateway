{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GatewayAPI": "Debug"
    }
  },
  "Gateway": {
    "Routes": [
      // ... suas rotas existentes
    ],
    // Endereços dos programas para onde o gateway encaminha.
    // Se um programa mudar de máquina (ex.: para a VM), troque só o endereço aqui.
    "Servicos": {
      "Produto": "http://localhost:6001",
      "Fornecedor": "http://localhost:6002",
      "Cliente": "http://localhost:6003",
      "Datasheet": "http://localhost:6004"
    },
    "Ariba": {
      "EntradaUrl": "http://localhost:5001", // onde o programa de origem envia
      "ServicoUrl": "http://localhost:6005" // onde o AribaSourcing escuta
    },
    "Timeout": {
      "DefaultSeconds": 3600, // ⭐ 1 hora
      "MaxSeconds": 7200, // ⭐ 2 horas
      "HttpClientTimeoutMinutes": 60
    },
    // Chave de API: vazia = sem autenticação. Para ativar, defina a variável de ambiente
    // Gateway__ApiKey no servidor (não grave a chave neste arquivo) e envie o cabeçalho X-Api-Key.
    "ApiKey": "",
    "Swagger": true,
    "Logs": {
      "Pasta": "" // vazio = pasta "logs" (como serviço: ao lado da pasta do app)
    }
  },
  "AllowedHosts": "*"
}
