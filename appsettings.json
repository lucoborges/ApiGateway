{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GatewayAPI": "Debug"
    }
  },
  "Gateway": {
    "Routes": [
      // ... suas rotas existentes
    ],
    // Endereços dos programas para onde o gateway encaminha.
    // Se um programa mudar de máquina (ex.: para a VM), troque só o endereço aqui.
    "Servicos": {
      "Produto": "http://localhost:6001",
      "Fornecedor": "http://localhost:6002",
      "Cliente": "http://localhost:6003",
      "Transportadora": "http://localhost:6006",
      "Datasheet": "http://localhost:6004"
    },
    "Ariba": {
      "EntradaUrl": "http://localhost:5001", // onde o programa de origem envia
      "ServicoUrl": "http://localhost:6005" // onde o AribaSourcing escuta
    },
    "Timeout": {
      "DefaultSeconds": 3600, // ⭐ 1 hora
      "MaxSeconds": 7200, // ⭐ 2 horas
      "HttpClientTimeoutMinutes": 60
    },
    // Chave de API: vazia = sem autenticação. Para ativar, defina a variável de ambiente
    // Gateway__ApiKey no servidor (não grave a chave neste arquivo) e envie o cabeçalho X-Api-Key.
    "ApiKey": "",
    // Chave que o gateway envia (cabeçalho X-Api-Key) ao HSE-Cadastros: produtos, fornecedores, clientes e transportadoras.
    // Vazia = não envia. Tem de ser igual à Seguranca:ApiKey do HSE-Cadastros. Defina pela variável de
    // ambiente Gateway__ChaveCadastros no servidor (não grave a chave neste arquivo).
    "ChaveCadastros": "",
    // Chave que o gateway envia (cabeçalho X-Api-Key) ao AribaSourcing. Vazia = não envia. Tem de ser igual à
    // Api:Chave do AribaSourcing. Defina pela variável de ambiente Gateway__ChaveAriba no servidor.
    "ChaveAriba": "",
    // IPs que podem chamar o gateway pela rede, separados por vírgula. Vazio = qualquer um.
    // localhost e /health ficam sempre livres. No servidor: variável de ambiente Gateway__IpsPermitidos.
    "IpsPermitidos": "",
    // Documentação em /swagger: em produção fica desligada (em Development aparece sempre)
    "Swagger": false,
    "Logs": {
      "Pasta": "" // vazio = pasta "logs" (como serviço: ao lado da pasta do app)
    }
  },
  "AllowedHosts": "*"
}
